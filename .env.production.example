# Production environment for EC2. Copy to .env and fill in real values.
# NEVER commit the real .env file.

# Generate a strong key, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING

FLASK_CONFIG=production

# --- Database ---------------------------------------------------------------
# Option A: MySQL/MariaDB on the same EC2 instance (setup_ec2.sh creates this):
DATABASE_URL=mysql+pymysql://library_user:library_pass@localhost/library_db

# Option B: Amazon RDS (recommended for real deployments). Point at the RDS
# endpoint and put the credentials here instead. Leave the local URL commented.
# DATABASE_URL=mysql+pymysql://library_user:STRONG_PASSWORD@your-db.abc1234.us-east-1.rds.amazonaws.com/library_db

LOAN_PERIOD_DAYS=14
LOG_LEVEL=INFO
PORT=5000
