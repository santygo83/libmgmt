# systemd unit for the Library Management System (Gunicorn).
# Copy to /etc/systemd/system/library.service and adjust paths/user as needed.
#
#   sudo cp deploy/library.service /etc/systemd/system/library.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now library
#   sudo systemctl status library

[Unit]
Description=Library Management System (Gunicorn)
After=network.target
# If MySQL runs on this same instance, uncomment:
# After=network.target mysqld.service
# Wants=mysqld.service

[Service]
Type=notify
# The Linux user/group that owns the app files. On Amazon Linux this is often
# ec2-user; on Ubuntu, ubuntu. Do NOT run as root.
User=ec2-user
Group=ec2-user

# Absolute path to the project root on the server.
WorkingDirectory=/home/ec2-user/library-management

# Load secrets/config from the .env file (systemd reads KEY=VALUE lines).
EnvironmentFile=/home/ec2-user/library-management/.env

# Gunicorn binds to a local Unix socket that Nginx proxies to.
ExecStart=/home/ec2-user/library-management/.venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/run/library/library.sock \
    --access-logfile - \
    --error-logfile - \
    run:app

# Create /run/library owned by the service user for the socket.
RuntimeDirectory=library
RuntimeDirectoryMode=0755

Restart=always
RestartSec=3
# Give the app a moment to start before systemd considers it failed.
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
